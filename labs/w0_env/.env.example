# W0 环境变量模板
#
# 用法：
#   cd labs/w0_env
#   cp .env.example .env
#   # 然后填入你的真实 Key
#
# ⚠️ .env 已被仓库根目录的 .gitignore 排除，绝不会提交。请勿把 Key 写进代码。

# ---------- 主用模型（必需）----------
# 大多数国产模型兼容 OpenAI 协议，所以只要改 base_url 即可
# DeepSeek:  https://api.deepseek.com/v1                     模型 deepseek-chat
# 通义百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 智谱:      https://open.bigmodel.cn/api/paas/v4            模型 glm-4-plus
PRIMARY_BASE_URL=https://api.deepseek.com/v1
PRIMARY_API_KEY=
PRIMARY_MODEL=deepseek-chat

# ---------- 备用模型（推荐，用于容灾与对照评测）----------
BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BACKUP_API_KEY=
BACKUP_MODEL=qwen-plus

# ---------- Embedding（W2 用，现在可以先留空）----------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- 本地模型（Ollama，断网/省钱备胎）----------
# ollama serve && ollama pull qwen2.5:7b
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen2.5:7b

# ---------- 可观测性（W4 才接入，先建账号拿 Key）----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
